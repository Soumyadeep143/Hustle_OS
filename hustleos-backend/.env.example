# OpenAI API Configuration
OPENAI_API_KEY=sk-...

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs API Configuration
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=default

# Sarvam AI Text-to-Speech (preferred voice provider — see voice_providers/)
SARVAM_API_KEY=

# Database Configuration (Optional)
# If your network can't reach the Supabase direct connection (db.<ref>.supabase.co is
# IPv6-only on most tiers), use the Shared Pooler in session mode instead — get it from
# Supabase Dashboard > Connect > "Session pooler":
#   postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@localhost/hustleos

# Auth — secret used to sign login session tokens (JWT). Use a long random
# string in production; this dev placeholder is fine for local use only.
JWT_SECRET=dev-only-change-me

# Google Calendar OAuth (optional — leave unset and calendar sync stays
# honestly "not connected" instead of faking it). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with an authorized
# redirect URI matching GOOGLE_REDIRECT_URI below (backend URL, not frontend).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/calendar/callback

# RECALL memory/execution providers (optional — unset means Local providers are used)
MEM0_API_KEY=
NEEVCLOUD_API_KEY=

# Server Configuration
DEBUG=false
FRONTEND_URL=http://localhost:5173
API_PORT=3000
